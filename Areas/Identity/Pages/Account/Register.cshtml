
@page
@model RegisterModel

@{
    ViewData["Title"] = "Criar conta";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="login-page">

    <div class="login-container">

        <!-- Área ilustrativa -->

        <div class="login-image">

            <div class="image-content">

                <span class="paw">🐾</span>

                <h1>Doggie Inn</h1>

                <h2>Um novo lar para seu melhor amigo!</h2>

                <p>
                    Crie sua conta e acompanhe todo o cuidado
                    e carinho que seu pet merece.
                </p>

                <span class="dog-image">🐶</span>

                <p class="image-footer">
                    Cuidado, carinho e diversão para seu melhor amigo.
                </p>

            </div>

        </div>

        <!-- Área do formulário -->

        <div class="login-form-container">

            <div class="login-header">

                <span class="login-icon">🐾</span>

                <h2>Crie sua conta</h2>

                <p>Preencha seus dados para começar.</p>

            </div>

            <!-- Formulário de cadastro -->

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-error"
                     role="alert">
                </div>

                <!-- E-mail -->

                <div class="form-group">

                    <label asp-for="Input.Email">
                        E-mail
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="Digite seu e-mail" />

                    <span asp-validation-for="Input.Email"
                          class="validation-error">
                    </span>

                </div>

                <!-- Senha -->

                <div class="form-group">

                    <label asp-for="Input.Password">
                        Senha
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Crie uma senha" />

                    <span asp-validation-for="Input.Password"
                          class="validation-error">
                    </span>

                </div>

                <!-- Confirmar senha -->

                <div class="form-group">

                    <label asp-for="Input.ConfirmPassword">
                        Confirmar senha
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Digite a senha novamente" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="validation-error">
                    </span>

                </div>

                <!-- Botão de cadastro -->

                <button id="registerSubmit"
                        type="submit"
                        class="login-button">

                    Criar conta

                </button>

                <!-- Link para login -->

                <div class="register-container">

                    <p>
                        Já tem uma conta?
                    </p>

                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl">

                        Entrar

                    </a>

                </div>

            </form>

            <!-- Login externo -->

            @if (Model.ExternalLogins?.Count > 0)
            {
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div class="external-login">

                        <p>Ou entre com</p>

                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit"
                                    class="external-login-button"
                                    name="provider"
                                    value="@provider.Name">

                                @provider.DisplayName

                            </button>
                        }

                    </div>

                </form>
            }

        </div>

    </div>

    <!-- Rodapé -->

    <div class="login-footer">

        <p>
            Doggie Inn © 2026 - Cuidado e carinho para seu pet.
        </p>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
